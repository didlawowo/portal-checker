{
  "id": null,
  "uid": "portal-checker",
  "title": "Portal Checker",
  "tags": [
    "portal-checker",
    "kubernetes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "instance",
        "label": "Portal Checker instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(portal_checker_endpoints, instance)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(portal_checker_endpoint_tested{instance=~\"$instance\"}, namespace)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Current state (resource / host groups)",
      "description": "Groups, not URL paths. Unknown means at least one path has not been checked. Cached results may be stale; see freshness panels.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (portal_checker_endpoint_state{instance=~\"$instance\",namespace=~\"$namespace\"})",
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Never fully tested",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(portal_checker_endpoint_tested{instance=~\"$instance\",namespace=~\"$namespace\"} == bool 0)",
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Stale groups",
      "description": "Last full check older than CACHE_TTL_SECONDS. HTTP state remains the last observation.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(portal_checker_endpoint_stale{instance=~\"$instance\",namespace=~\"$namespace\"})",
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "TLS information unavailable",
      "description": "Unknown is neither valid nor expired. Certificate verification failures commonly appear here.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(portal_checker_endpoint_tls_state{instance=~\"$instance\",namespace=~\"$namespace\",state=\"unknown\"})",
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "State by namespace",
      "description": "",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, state) (portal_checker_endpoint_state{instance=~\"$instance\",namespace=~\"$namespace\"})",
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "title": "Ingress / HTTPRoute distribution",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (resource_type) (portal_checker_endpoint_tested{instance=~\"$instance\",namespace=~\"$namespace\"})",
          "legendFormat": "{{resource_type}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "Current resource states",
      "description": "Select one instance to avoid duplicate groups across independent exporters. A value of 1 selects the state label.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "portal_checker_endpoint_state{instance=~\"$instance\",namespace=~\"$namespace\"} == 1",
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "title": "Slowest groups",
      "description": "Maximum latency across paths in a group; absent until all paths have a check.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, portal_checker_endpoint_response_time_seconds{instance=~\"$instance\",namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}} / {{resource}} / {{host}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 9,
      "title": "Latency history",
      "description": "History is stored by Prometheus / VictoriaMetrics; Portal Checker only publishes the last check.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "portal_checker_endpoint_response_time_seconds{instance=~\"$instance\",namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}} / {{resource}} / {{host}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 10,
      "title": "Age of last complete check",
      "description": "",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "time() - (portal_checker_endpoint_last_check_timestamp_seconds{instance=~\"$instance\",namespace=~\"$namespace\"} > 0)",
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 11,
      "title": "Known TLS expirations (next 30 days or expired)",
      "description": "Earliest known certificate in each resource / host group. Unknown TLS is excluded, not treated as healthy.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "((portal_checker_endpoint_tls_expiry_timestamp_seconds{instance=~\"$instance\",namespace=~\"$namespace\"} - time()) / 86400) < 30",
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 12,
      "title": "Expired TLS groups (known only)",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((portal_checker_endpoint_tls_expiry_timestamp_seconds{instance=~\"$instance\",namespace=~\"$namespace\"} - time()) / 86400) < bool 0)",
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 13,
      "title": "TLS groups expiring in 0\u20137 days",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((((portal_checker_endpoint_tls_expiry_timestamp_seconds{instance=~\"$instance\",namespace=~\"$namespace\"} - time()) / 86400) >= bool 0) * (((portal_checker_endpoint_tls_expiry_timestamp_seconds{instance=~\"$instance\",namespace=~\"$namespace\"} - time()) / 86400) < bool 7))",
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 14,
      "title": "TLS groups expiring in 7\u201330 days",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((((portal_checker_endpoint_tls_expiry_timestamp_seconds{instance=~\"$instance\",namespace=~\"$namespace\"} - time()) / 86400) >= bool 7) * (((portal_checker_endpoint_tls_expiry_timestamp_seconds{instance=~\"$instance\",namespace=~\"$namespace\"} - time()) / 86400) < bool 30))",
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    }
  ]
}
